name: Send QQ Mail Every Morning

on:
  schedule:
    # UTC 0:00 = 北京时间早上 8:00
    - cron: '0 0 * * *'
  workflow_dispatch: # 允许手动触发测试

jobs:
  send-mail:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Send email
        env:
          QQ_EMAIL: ${{ secrets.QQ_EMAIL }}        # 发件QQ邮箱
          QQ_AUTH_CODE: ${{ secrets.QQ_AUTH_CODE }} # QQ邮箱SMTP授权码
          TO_EMAIL: ${{ secrets.TO_EMAIL }}        # 收件人邮箱
          MAIL_SUBJECT: ${{ vars.MAIL_SUBJECT }}   # 邮件主题（可选，在 Variables 里配置）
          MAIL_CONTENT: ${{ vars.MAIL_CONTENT }}   # 邮件正文（在 Variables 里配置）
        run: python send_mail.py
